# Web3Forms Configuration (legacy — kept for other forms)
# Steps to get your key (takes 30 seconds, no account needed!):
# 1. Go to https://web3forms.com
# 2. Enter "jaimanisa@supporticon.com" in the email field
# 3. Click "Create your Access Key"
# 4. Check jaimanisa@supporticon.com inbox for the key
# 5. Paste it below and restart the dev server (npm run dev)
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here

# ─── Secure Backend API (for Request Demo form) ───────────────────────────────
# Local development: http://localhost:3001
# Production: Replace with your deployed backend URL (e.g. https://api.supporticon.com)
VITE_API_URL=http://localhost:3001
